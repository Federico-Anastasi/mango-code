runtime/
*.log

# node dependencies
node_modules/

# cloud keys (e.g. OpenRouter): never versioned
mango-secrets.json

# The agent built from the repo's sources (app/scripts/build-agent.ps1): web/mango-code.exe.
/opencode/

# Paths of THIS machine (engines, GGUF models, agent), written by hand: the optional file the app and the scripts read
# to find them elsewhere than in its data folder.
mango-paths.json

# opencode: the app generates its REAL config at every start from the template, with the running model's numbers
# (the context changes with the model). Versioning the generated file would mean versioning a state.
opencode-home/opencode.json
opencode-home/node_modules/
# The agent's plugin packages (@opencode-ai/plugin) are tracked (package.json, package-lock.json): the installer
# carries them. The agent writes its own lockfile at start.
opencode-home/bun.lock
