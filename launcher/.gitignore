runtime/
*.log
srv_*.txt

# node dependencies
node_modules/

# cloud keys (e.g. OpenRouter): never versioned
mango-secrets.json

# The agent built from the repo's sources (setup.ps1 -Only opencode): web/mango-code.exe.
/opencode/

# paths of THIS machine (llama.cpp binaries, GGUF folder): written by setup.ps1.
# It is the only one of these that is NOT generated from a template: setup.ps1 writes it by asking
# (or guessing) where they are, and it is the source the templates take the paths from.
mango-paths.json

# Python: the bytecode cache left by importing mango-voice.py (e.g. mango-voice-test.py).
__pycache__/

# opencode: the REAL config is generated by mango-code.ps1 at every start from the template, with the
# running model's numbers (the context changes with the model). Versioning the generated file would mean
# versioning a state, and at the first model switch it would already be wrong.
opencode-home/opencode.json
opencode-home/node_modules/
# The agent's plugin packages (@opencode-ai/plugin) are tracked (package.json, package-lock.json): the installer
# carries them, and `setup.ps1 -Only npm` installs them. The agent writes its own lockfile at start.
opencode-home/bun.lock
