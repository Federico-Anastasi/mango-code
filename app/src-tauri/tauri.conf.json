{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mango Code",
  "version": "0.1.0",
  "identifier": "dev.mango.code",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Mango",
    "shortDescription": "Coding assistant that runs on your computer",
    "longDescription": "Mango Code: a coding assistant that uses a language model running on your computer.",
    "resources": { "../scripts/staging/resources/": "resources/" },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
