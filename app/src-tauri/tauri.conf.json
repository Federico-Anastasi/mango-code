{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mango Code",
  "version": "0.1.0-rc.4",
  "identifier": "dev.mango.code",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Mango",
    "shortDescription": "Coding assistant that runs on your computer",
    "longDescription": "Mango Code: a coding assistant that uses a language model running on your computer.",
    "resources": { "../scripts/staging/resources/": "resources/" },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MDJEMDEzRTAyMjE3NUQKUldSZEZ5TGdFOUFDNUdIVnk1QUdtVTlxM0pYcDI4TzIxZ2pWaWFBODUxUUkzQlFQV1BzeFFmbUkK",
      "endpoints": ["https://github.com/Federico-Anastasi/mango-code/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
